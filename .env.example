# Settings for the Spanish practice app.
# Copy this file to ".env" and fill in the real values. Never share or commit .env:
# it holds the API keys and the learner's personal details.
# On the server it lives next to the "spanish" folder and is blocked from the web by .htaccess.

# ---------- About the learner (shown in the lessons, never stored in the code) ----------
CHILD_NAME=Sofia
# Year-month-day. Her age and birthday sentences are worked out from this.
CHILD_BIRTHDAY=2014-03-15
CHILD_CITY=London
# As it should read in Spanish after "Mi héroe es ..."
CHILD_HERO=Shakira
# Her cat
PET_NAME=Luna
PET_AGE=2
STEPBROTHER_NAME=Leo
STEPBROTHER_AGE=20
# A girl cousin
COUSIN_NAME=Maya
COUSIN_AGE=14
# Her best friend (a girl)
FRIEND_NAME=Ella
FRIEND_AGE=12

# ---------- API keys ----------
# OpenRouter key (https://openrouter.ai/keys): the main route for voices and listening models
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
# Google AI Studio key (https://aistudio.google.com/apikey): the Gemini Flash listener, and a fallback for Gemini speech
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# ---------- Voices and models ----------
# What a fresh device starts with; both can be changed in the app's Settings.
# Voices: gemini-lite, gemini, mai, grok, kokoro    Listeners: gemini-flash, gpt-mini, gemini-transcribe, whisper
DEFAULT_VOICE=gemini-lite
DEFAULT_LISTEN=gpt-mini
# Models behind the "gemini-lite" voice and the "gemini-flash" listener
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_LISTEN_MODEL=gemini-3.8-flash
# Gemini voice names: Leda, Zephyr, Puck, Kore, Aoede, Callirrhoe, Despina, Sulafat ...
VOICE_SPANISH=Leda
VOICE_PRAISE=Zephyr
# Safety cap on AI calls per day (cached phrases don't count)
DAILY_LIMIT=3000

# ---------- Deployment ----------
# Where the app is live; used by tools/warm-cache.mjs
SITE_URL=https://example.com/spanish
# Name of the browser storage slot that holds progress. Changing it starts everyone from zero.
STORAGE_KEY=spanish-app-v1
# Optional: ProjectManager credential ids, for "node tools/package.mjs --sync"
PM_PROJECT_ID=
PM_GEMINI_CREDENTIAL_ID=
PM_OPENROUTER_CREDENTIAL_ID=
